# =====================================================================
# agent-base 环境变量模板
# ---------------------------------------------------------------------
# 复制为 .env 并填入真实值（.env 不提交，密钥不落盘）。
# configs/app.yaml 中的 ${VAR:-默认值} 会读取同名环境变量覆盖默认值。
# =====================================================================

# ---------- 服务连接（本地开发用默认值即可，生产按环境覆盖） ----------
# Qdrant 向量库
QDRANT_URL=http://localhost:6333
# PostgreSQL（真相源 / 会话 / 订单）
PG_URL=postgresql://postgres:postgres@localhost:5432/ragdb
# Redis（缓存 / 短期记忆）
REDIS_HOST=localhost
REDIS_PORT=6379
# Embedding 服务（本地 Ollama / v1；云端可切 DashScope）
EMBEDDING_BASE_URL=http://localhost:11434/v1
# CI/无外部向量服务时设 hash（确定性本地向量，免 Ollama）
EMBEDDING_PROVIDER=openai
# 重排服务（TEI bge-reranker-v2-m3）
RERANK_ENDPOINT=http://localhost:8081/rerank
# CI/无重排服务时设 none（跳过重排）
RERANK_PROVIDER=local_tei
# 生成 LLM（DeepSeek OpenAI 兼容网关）
LLM_BASE_URL=https://api.deepseek.com
# LangGraph PostgresSaver 断点续跑连接串（留空=自动推断）
CHECKPOINT_DB_URL=

# ---------- 密钥 ----------
# 文本 LLM 网关 Token（DeepSeek）
ANTHROPIC_AUTH_TOKEN=
# Embedding 云端 Key（本地 Ollama 不校验，可留空）
DASHSCOPE_API_KEY=
# 视觉模型（火山方舟 ARK，多模态用）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428
# MinerU 文档解析（PDF/扫描件 → Markdown；留空走 mock 解析，不阻塞上传链路）
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4/extract/task

# ---------- 生产告警（可选：配置后自动推送群机器人） ----------
# 钉钉/企微自定义机器人 webhook；ALERT_ENABLED=true 开启巡检
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
# dingtalk | wecom（机器人 markdown 消息格式差异）
ALERT_WEBHOOK_STYLE=dingtalk


# ---------- 快捷登录（可选） ----------
# 手机验证码登录：mock=开发模式（验证码随响应返回）；aliyun=真实短信（需配置下面三项）
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# ---------- 管理接口鉴权（生产环境务必修改） ----------
ADMIN_TOKEN=admin-dev-token-2026
PLATFORM_TOKEN=platform-dev-token-2026